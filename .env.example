# Supabase project (Dashboard → Project Settings → API). Only the public anon key belongs here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://jobsinkolar.com

# Optional contact details shown on the site (hidden when empty).
NEXT_PUBLIC_SUPPORT_EMAIL=support@jobsinkolar.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Shown on GST invoices.
NEXT_PUBLIC_SELLER_NAME=Jobs in Kolar
NEXT_PUBLIC_SELLER_GSTIN=
